{
  "type": "webhook",
  "name": "list_event_packages",
  "description": "List ticket packages for one event including packageId, price, and remaining inventory.",
  "api_schema": {
    "url": "https://YOUR_PUBLIC_HOST/api/v1/agent/tools/list-event-packages",
    "method": "POST",
    "request_headers": {
      "X-EventPulse-Agent-Secret": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Event id from list_events"
        }
      },
      "required": ["eventId"]
    }
  }
}

{
  "type": "webhook",
  "name": "sign_in_attendee",
  "description": "Sign in an EventPulse attendee with email and password. Returns agentSessionToken for quote and booking tools. Use before any purchase.",
  "api_schema": {
    "url": "https://YOUR_PUBLIC_HOST/api/v1/agent/tools/sign-in-attendee",
    "method": "POST",
    "request_headers": {
      "X-EventPulse-Agent-Secret": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Attendee email on EventPulse"
        },
        "password": {
          "type": "string",
          "description": "Attendee password"
        }
      },
      "required": ["email", "password"]
    }
  }
}

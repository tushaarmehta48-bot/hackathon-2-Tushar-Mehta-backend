NODE_ENV=development

PORT=3001

MONGODB_URI=

# Comma-separated frontend origins (Vercel + local dev)
CORS_ORIGIN=http://localhost:3000,https://hackathon-2-tushar-mehta-frontend.vercel.app

# Optional: absolute base for new upload URLs (defaults to /api/v1/media/... paths)
# PUBLIC_API_URL=

# Banner files are stored on disk at uploads/event-banners. On Render, that folder is
# ephemeral unless you attach a persistent disk at uploads/ — then re-upload via admin.

SESSION_SECRET=

BOOTSTRAP_ADMIN_EMAIL=

BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret for ElevenLabs webhook tools (header X-EventPulse-Agent-Secret)
EVENTPULSE_AGENT_WEBHOOK_SECRET=

